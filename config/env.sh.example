# 复制为 config/env.sh（chmod 600），由 bin/run.sh 在启动时 source。
# 本文件不含任何密钥。

# pi（编码 Agent）调用大模型所需的密钥
export DEEPSEEK_API_KEY="sk-REPLACE_ME"

# 关键：让 node v22 优先于 /usr/bin/node（v20）。
# pi 依赖 fs.globSync，Node 20 会秒崩（exit 1，报 "does not provide an export named 'globSync'"）。
export PATH="/root/.local/bin:/usr/local/bin:/usr/bin:/bin"

# 可选：离线/无网环境下让 pi 显式走已保存的凭据
# export PI_OFFLINE=1