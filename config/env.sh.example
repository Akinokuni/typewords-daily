# 复制为 config/env.sh（chmod 600），由 bin/run.sh 在启动时 source。
# 本文件不含任何密钥。
#
# 大模型密钥的推荐落点：pi 自己的凭据文件 ~/.pi/agent/auth.json（0600），
# 由 ~/.pi/agent/models.json 声明的自定义 provider（默认 qwen-maas）引用。
# 下面这个环境变量只作回退（pi 的优先级：--api-key > auth.json > 环境变量 > models.json）。
export QWEN_MAAS_API_KEY="«在此填 Token Plan 密钥，形如 sk-sp-…»"
# 若仍使用 pi 内建 deepseek provider，则改为 export DEEPSEEK_API_KEY="…"

# 关键：让 node v22 优先于 /usr/bin/node（v20）。
# pi 依赖 fs.globSync，Node 20 会秒崩（exit 1，报 "does not provide an export named 'globSync'"）。
export PATH="/root/.local/bin:/usr/local/bin:/usr/bin:/bin"

# 可选：离线/无网环境下让 pi 显式走已保存的凭据
# export PI_OFFLINE=1